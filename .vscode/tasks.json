{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build THERMATRIX (CMake)",
            "type": "shell",
            "command": "cmake --build build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Run All Tests (CTest)",
            "type": "shell",
            "command": "cd build && ctest --output-on-failure",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
